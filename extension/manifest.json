{
  "manifest_version": 3,
  "name": "Tidy Tabs",
  "description": "Groups your tabs by what they're for, using Apple Intelligence on your Mac.",
  "version": "1.2.0",
  "key": "",
  "minimum_chrome_version": "120",
  "permissions": [
    "tabs",
    "tabGroups",
    "nativeMessaging",
    "contextMenus",
    "storage"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Tidy Tabs: group loose tabs with Apple Intelligence",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "commands": {
    "tidy-tabs": {
      "suggested_key": {
        "default": "Alt+Shift+T",
        "mac": "Alt+Shift+T"
      },
      "description": "Tidy loose tabs"
    },
    "retidy-tabs": {
      "suggested_key": {
        "default": "Alt+Shift+R",
        "mac": "Alt+Shift+R"
      },
      "description": "Re-tidy all tabs, including ones already in groups"
    }
  }
}
